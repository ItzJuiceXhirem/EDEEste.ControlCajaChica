@page "/usuarios"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permisos.AdministrarUsuarios)]

<PageTitle>Usuarios y accesos</PageTitle>

<h1>Usuarios y accesos</h1>

@if (mensaje is not null)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (usuarios is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <section class="mb-5">
        <h2 class="h5">Solicitudes de acceso</h2>
        <p class="text-muted small">
            Personas que crearon su cuenta y esperan que se les asigne un rol. Mientras
            esten aqui no pueden entrar al sistema.
        </p>
        @if (Filtrar(EstadoAccesoUsuario.Pendiente).Count == 0)
        {
            <p class="text-muted">No hay solicitudes pendientes.</p>
        }
        else
        {
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th style="width: 220px;">Asignar rol</th>
                        <th style="width: 150px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Filtrar(EstadoAccesoUsuario.Pendiente))
                    {
                        <tr>
                            <td><code>@usuario.Usuario</code></td>
                            <td>@usuario.Nombre</td>
                            <td>
                                <select class="form-select form-select-sm"
                                        disabled="@(procesandoId == usuario.Id)"
                                        @onchange="e => AprobarAsync(usuario, e.Value?.ToString())">
                                    <option value="">Seleccione un rol...</option>
                                    @foreach (var rol in RolesApp.Todos)
                                    {
                                        <option value="@rol">@rol</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@(procesandoId == usuario.Id)"
                                        @onclick="() => DenegarAsync(usuario)">
                                    Denegar acceso
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="mb-5">
        <h2 class="h5">Usuarios con acceso</h2>
        @if (Filtrar(EstadoAccesoUsuario.Aprobado).Count == 0)
        {
            <p class="text-muted">Todavia no hay usuarios aprobados.</p>
        }
        else
        {
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th style="width: 220px;">Rol</th>
                        <th style="width: 150px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Filtrar(EstadoAccesoUsuario.Aprobado))
                    {
                        <tr>
                            <td><code>@usuario.Usuario</code></td>
                            <td>@usuario.Nombre</td>
                            <td>
                                <select class="form-select form-select-sm"
                                        value="@usuario.Rol"
                                        disabled="@(procesandoId == usuario.Id)"
                                        @onchange="e => CambiarRolAsync(usuario, e.Value?.ToString())">
                                    @foreach (var rol in RolesApp.Todos)
                                    {
                                        <option value="@rol" selected="@(rol == usuario.Rol)">@rol</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger"
                                        disabled="@(procesandoId == usuario.Id)"
                                        @onclick="() => DenegarAsync(usuario)">
                                    Revocar acceso
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2 class="h5">Acceso denegado</h2>
        <p class="text-muted small">
            Cuentas a las que se les nego el acceso. Se conserva el rol que tenian por
            si hay que devolverles el acceso mas adelante.
        </p>
        @if (Filtrar(EstadoAccesoUsuario.Denegado).Count == 0)
        {
            <p class="text-muted">No hay cuentas con acceso denegado.</p>
        }
        else
        {
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Nombre</th>
                        <th>Rol anterior</th>
                        <th style="width: 220px;">Devolver acceso como</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Filtrar(EstadoAccesoUsuario.Denegado))
                    {
                        <tr>
                            <td><code>@usuario.Usuario</code></td>
                            <td>@usuario.Nombre</td>
                            <td>@(usuario.Rol ?? "-")</td>
                            <td>
                                <select class="form-select form-select-sm"
                                        disabled="@(procesandoId == usuario.Id)"
                                        @onchange="e => AprobarAsync(usuario, e.Value?.ToString())">
                                    <option value="">Seleccione un rol...</option>
                                    @foreach (var rol in RolesApp.Todos)
                                    {
                                        <option value="@rol">@rol</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}
