@page "/fondos"
@rendermode InteractiveServer

@inject IFondoRepository RepositorioFondos
@inject IApplicationDbContext Contexto

<PageTitle>Fondos de caja chica</PageTitle>

<h1>Fondos de caja chica</h1>

@* Pantalla provisional de administracion: existe para poder crear el fondo con el
   que se prueban los gastos y las reposiciones. Cuando se implemente el caso de uso
   del Administrador (configurar fondos, limites y custodios) esta pagina deberia
   pasar a llamar ese comando en vez de escribir por el repositorio. *@

@if (mensaje is not null)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row">
    <div class="col-lg-7">
        <h2 class="h5">Fondos registrados</h2>

        @if (fondos is null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (fondos.Count == 0)
        {
            <p class="text-muted">Todavia no hay fondos. Cree uno con el formulario de la derecha.</p>
        }
        else
        {
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Custodio</th>
                        <th class="text-end">Fondo fijo</th>
                        <th class="text-end">Balance</th>
                        <th class="text-end">% restante</th>
                        <th class="text-end">Limite/gasto</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fondo in fondos)
                    {
                        var porcentaje = fondo.MontoFijo > 0 ? fondo.BalanceActual / fondo.MontoFijo * 100m : 0m;
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(fondo.CustodioId) ? "(sin asignar)" : fondo.CustodioId)</td>
                            <td class="text-end">@fondo.MontoFijo.ToString("N2")</td>
                            <td class="text-end">@fondo.BalanceActual.ToString("N2")</td>
                            <td class="text-end">@porcentaje.ToString("N1")%</td>
                            <td class="text-end">@LimiteEfectivo(fondo).ToString("N2")</td>
                            <td>@fondo.Estado</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-lg-5">
        <h2 class="h5">Nuevo fondo</h2>
        <EditForm Model="entrada" OnValidSubmit="CrearAsync" FormName="nuevo-fondo">
            <div class="mb-2">
                <label class="form-label">Monto fijo (RD$)</label>
                <InputNumber @bind-Value="entrada.MontoFijo" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">Limite por gasto (RD$)</label>
                <InputNumber @bind-Value="entrada.LimitePorGasto" class="form-control" />
                <div class="form-text">
                    Dejelo en 0 para usar el tope reglamentario (2.5% del fondo fijo).
                    Un valor mayor a ese tope no surte efecto: siempre manda el mas estricto.
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label">% de alerta para reposicion</label>
                <InputNumber @bind-Value="entrada.PorcentajeAlertaReposicion" class="form-control" />
                <div class="form-text">La reposicion se habilita cuando el balance baja de este porcentaje.</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Id del custodio</label>
                <InputText @bind-Value="entrada.CustodioId" class="form-control" />
                <div class="form-text">Provisional: se escribe a mano hasta que exista la pantalla de asignacion de usuarios.</div>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@guardando">
                @(guardando ? "Guardando..." : "Crear fondo")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private IReadOnlyList<FondoCajaChica>? fondos;
    private readonly EntradaFondo entrada = new();
    private bool guardando;
    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync() => await RecargarAsync();

    private async Task RecargarAsync() => fondos = await RepositorioFondos.ListarAsync();

    private static decimal LimiteEfectivo(FondoCajaChica fondo)
    {
        var tope = fondo.MontoFijo * 0.025m;
        return fondo.LimitePorGasto > 0 ? Math.Min(fondo.LimitePorGasto, tope) : tope;
    }

    private async Task CrearAsync()
    {
        mensaje = null;
        error = null;

        if (entrada.MontoFijo <= 0)
        {
            error = "El monto fijo debe ser mayor que cero.";
            return;
        }

        guardando = true;
        try
        {
            var fondo = new FondoCajaChica
            {
                MontoFijo = entrada.MontoFijo,
                // Un fondo nace con el efectivo completo en caja.
                BalanceActual = entrada.MontoFijo,
                LimitePorGasto = entrada.LimitePorGasto,
                PorcentajeAlertaReposicion = entrada.PorcentajeAlertaReposicion,
                CustodioId = entrada.CustodioId?.Trim() ?? string.Empty,
                Estado = EstadoFondo.Activo
            };

            await RepositorioFondos.AgregarAsync(fondo);
            await Contexto.SaveChangesAsync();

            mensaje = $"Fondo creado con RD$ {fondo.MontoFijo:N2}.";
            entrada.Limpiar();
            await RecargarAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private sealed class EntradaFondo
    {
        public decimal MontoFijo { get; set; }
        public decimal LimitePorGasto { get; set; }
        public decimal PorcentajeAlertaReposicion { get; set; } = 30m;
        public string? CustodioId { get; set; }

        public void Limpiar()
        {
            MontoFijo = 0;
            LimitePorGasto = 0;
            PorcentajeAlertaReposicion = 30m;
            CustodioId = null;
        }
    }
}
