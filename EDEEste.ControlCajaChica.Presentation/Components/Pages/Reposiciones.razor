@page "/reposiciones"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permisos.VerReposiciones)]

<PageTitle>Reposiciones</PageTitle>

<div class="rep-rowt">
    <div>
        <h1 class="rep-h1">Reposiciones</h1>
        <p class="rep-sub">@Subtitulo</p>
    </div>

    @* Sólo Custodio y Auditor tienen trabajo atado a un fondo concreto: para
       Gerente y Finanzas, que trabajan por cola global, el selector baja al
       pliegue de "Consulta por fondo" en vez de ocupar la cabecera. *@
    @if (fondos is { Count: > 0 } && (puedeSolicitar || EsSoloConsulta))
    {
        <div class="rep-fondo-pick">
            <span class="rep-lbl">Fondo</span>
            <select class="rep-select" value="@fondoSeleccionado" @onchange="CambiarFondoAsync">
                @foreach (var fondo in fondos)
                {
                    <option value="@fondo.Id">
                        Custodio @NombreCustodio(fondo.CustodioId) &mdash; RD$ @fondo.BalanceActual.ToString("N2")
                    </option>
                }
            </select>
        </div>
    }
</div>

@if (errores.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in errores)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
@if (exito is not null)
{
    <div class="alert alert-success">@exito</div>
}

@if (fondos is null)
{
    <p><em>Cargando...</em></p>
}
else if (fondos.Count == 0)
{
    <div class="alert alert-warning">Primero cree <a href="/fondos">un fondo</a>.</div>
}
else
{
    <div class="rep-inbox rep-mt18">
        @if (puedeSolicitar)
        {
            @RenderBandejaCustodio()
        }
        else if (puedeAprobar)
        {
            @RenderBandejaGerente()
        }
        else if (puedePagar)
        {
            @RenderBandejaFinanzas()
        }
        else
        {
            @RenderBandejaAuditor()
        }
    </div>

    @if (puedeSolicitar)
    {
        <div class="rep-fold">
            <div class="rep-foldlbl"><span class="rep-cap">Historial de este fondo</span><span class="rep-line"></span></div>
            @RenderTablaCustodio()
        </div>
    }
    else if (puedeAprobar || puedePagar)
    {
        <div class="rep-fold">
            <div class="rep-foldlbl">
                <span class="rep-cap">Consulta por fondo</span>
                <span class="rep-line"></span>
                <div class="rep-fondo-pick rep-fondo-pick-inline">
                    <select class="rep-select" value="@fondoSeleccionado" @onchange="CambiarFondoAsync">
                        @foreach (var fondo in fondos)
                        {
                            <option value="@fondo.Id">
                                Custodio @NombreCustodio(fondo.CustodioId) &mdash; RD$ @fondo.BalanceActual.ToString("N2")
                            </option>
                        }
                    </select>
                </div>
            </div>
            @if (puedeAprobar)
            {
                @RenderTablaGerente()
            }
            else
            {
                @RenderTablaFinanzas()
            }
        </div>
    }
    else
    {
        <div class="rep-mt14">
            @RenderTablaAuditor()
        </div>
    }
}

@code {
    // ── Bandejas (§A · Bandeja) ──────────────────────────────────────────────

    private RenderFragment RenderBandejaCustodio() =>
        @<text>
            <div class="rep-job @(pendientes is { Count: > 0 } && !Habilitada ? "quiet" : "")">
                <span class="rep-jic">@RenderIcono(IconoReloj)</span>
                <div>
                    <div class="rep-jt">
                        @(pendientes is not { Count: > 0 }
                            ? "No hay gastos pendientes"
                            : Habilitada ? "Puede solicitar la reposición" : "Aún no puede solicitar")
                    </div>
                    <div class="rep-jd">
                        <span class="rep-scope fondo">@RenderIcono(IconoFondo, "12") Sólo este fondo</span>
                        @if (fondoActual is not null)
                        {
                            <span>
                                Quedan RD$ @fondoActual.BalanceActual.ToString("N2") de RD$ @fondoActual.MontoFijo.ToString("N2")
                                &middot; el umbral es RD$ @Umbral.ToString("N2")
                            </span>
                        }
                    </div>
                </div>
                <div>
                    <div class="rep-jn cc-num">RD$@TotalPendientes.ToString("N0")</div>
                    <div class="rep-jnl">a reponer</div>
                </div>
            </div>

            @if (pendientes is { Count: > 0 })
            {
                <div class="rep-card">
                    <div class="rep-cb-head">
                        <div class="rep-row">
                            <h2 class="rep-h2">Gastos que entrarían</h2>
                            <span class="rep-mut" style="font-size:12px">se toman todos los pendientes, no se eligen</span>
                        </div>
                    </div>
                    <div class="rep-cb-body">
                        <div class="rep-tablewrap">
                            <table class="rep-table">
                                <thead>
                                    <tr><th>Fecha</th><th>NCF</th><th>Proveedor</th><th class="c">Adj.</th><th class="r">Monto</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var gasto in pendientes)
                                    {
                                        <tr>
                                            <td class="cc-num">@gasto.FechaGasto.ToString("dd/MM/yyyy")</td>
                                            <td>@gasto.NCF</td>
                                            <td>@gasto.Proveedor</td>
                                            <td class="c">@gasto.Comprobantes.Count</td>
                                            <td class="r rep-money">@gasto.MontoTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="rep-tfoot"><span>Total a reponer</span><span class="v cc-num">RD$ @TotalPendientes.ToString("N2")</span></div>

                        @if (!Habilitada)
                        {
                            <div class="rep-alert rep-a-warn rep-mt14">
                                @RenderIcono(IconoAlerta)
                                <span>
                                    Quedan RD$ @fondoActual!.BalanceActual.ToString("N2") en el fondo.
                                    La reposición se habilita al bajar de RD$ @Umbral.ToString("N2")
                                    (@PorcentajeAlerta(fondoActual).ToString("N0")% del fondo fijo).
                                </span>
                            </div>
                        }

                        <div class="rep-mt14" style="display:flex;justify-content:flex-end">
                            <button type="button" class="rep-btn rep-btn-pri" disabled="@(generando || !Habilitada)" @onclick="GenerarAsync">
                                @(generando ? "Generando expediente..." : "Generar solicitud y expediente PDF")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </text>;

    private RenderFragment RenderBandejaGerente() =>
        @<text>
            <div class="rep-job @(porAprobar is { Count: > 0 } ? "" : "quiet")">
                <span class="rep-jic">@RenderIcono(IconoCheck)</span>
                <div>
                    <div class="rep-jt">@(porAprobar is { Count: > 0 } ? "Esperan su aprobación" : "Nada pendiente de aprobación")</div>
                    <div class="rep-jd">
                        <span class="rep-scope">@RenderIcono(IconoLista, "12") Todos los fondos</span>
                        @if (porAprobar is { Count: > 0 })
                        {
                            <span>@DescripcionEsperaGerente</span>
                        }
                    </div>
                </div>
                <div>
                    <div class="rep-jn cc-num">@(porAprobar?.Count ?? 0)</div>
                    <div class="rep-jnl">solicitudes</div>
                </div>
            </div>

            @if (porAprobar is { Count: > 0 })
            {
                <div class="rep-card">
                    <div class="rep-cb">
                        <div class="rep-alert rep-a-warn">
                            @RenderIcono(IconoAlerta)
                            <span>
                                Al rechazar, los gastos vuelven a quedar pendientes de reposición y podrán entrar en una
                                nueva solicitud. El expediente PDF se conserva en el historial.
                            </span>
                        </div>
                        <div class="rep-tablewrap rep-mt14">
                            <table class="rep-table">
                                <thead>
                                    <tr>
                                        <th>Solicitada</th><th>Fondo</th><th class="r">Monto reclamado</th>
                                        <th class="c">Gastos</th><th>Expediente</th><th class="act">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var solicitud in porAprobar)
                                    {
                                        <tr>
                                            <td class="cc-num">@FormatoFechaHora(solicitud.FechaSolicitud)</td>
                                            <td>@NombreCustodio(solicitud.FondoCajaChica?.CustodioId ?? string.Empty)</td>
                                            <td class="r rep-money">@solicitud.MontoReclamado.ToString("N2")</td>
                                            <td class="c">@solicitud.Gastos.Count</td>
                                            <td>@RenderPdf(solicitud)</td>
                                            <td class="act">
                                                <span class="rep-g6">
                                                    <button type="button" class="rep-btn rep-btn-ok rep-btn-sm"
                                                            disabled="@(procesando is not null)" @onclick="() => AprobarAsync(solicitud.Id, true)">
                                                        Aprobar
                                                    </button>
                                                    <button type="button" class="rep-btn rep-btn-bad rep-btn-sm"
                                                            disabled="@(procesando is not null)" @onclick="() => AprobarAsync(solicitud.Id, false)">
                                                        Rechazar
                                                    </button>
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="rep-job quiet">
                <span class="rep-jic">@RenderIcono(IconoGuion)</span>
                <div>
                    <div class="rep-jt">Nada más pendiente para usted</div>
                    <div class="rep-jd"><span>El pago lo registra Finanzas; después de aprobar, usted no vuelve a intervenir.</span></div>
                </div>
                <div>
                    <div class="rep-jn cc-num">0</div>
                    <div class="rep-jnl">acciones</div>
                </div>
            </div>
        </text>;

    private RenderFragment RenderBandejaFinanzas() =>
        @<text>
            <div class="rep-job @(porPagar is { Count: > 0 } ? "" : "quiet")">
                <span class="rep-jic">@RenderIcono(IconoBandeja)</span>
                <div>
                    <div class="rep-jt">@(porPagar is { Count: > 0 } ? "Listas para pagar" : "Nada por pagar ahora")</div>
                    <div class="rep-jd">
                        <span class="rep-scope">@RenderIcono(IconoLista, "12") Todos los fondos</span>
                        @if (porPagar is { Count: > 0 })
                        {
                            <span>Aprobadas por el Gerente y a la espera de la transferencia</span>
                        }
                    </div>
                </div>
                <div>
                    <div class="rep-jn cc-num">RD$@TotalPorPagar.ToString("N0")</div>
                    <div class="rep-jnl">por pagar</div>
                </div>
            </div>

            @if (porPagar is { Count: > 0 })
            {
                <div class="rep-card">
                    <div class="rep-cb">
                        <div class="rep-alert rep-a-info">
                            @RenderIcono(IconoAlerta)
                            <span>La referencia es obligatoria: es la prueba externa de que el dinero salió de tesorería. Sin ella el pago se rechaza.</span>
                        </div>
                        <div class="rep-tablewrap rep-mt14">
                            <table class="rep-table">
                                <thead>
                                    <tr>
                                        <th>Aprobada</th><th>Fondo</th><th class="r">Monto a pagar</th><th>Expediente</th>
                                        <th style="min-width:230px">Referencia de pago</th><th class="act"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var solicitud in porPagar)
                                    {
                                        <tr>
                                            <td class="cc-num">@FormatoFechaHoraOpcional(solicitud.FechaAprobacion)</td>
                                            <td>@NombreCustodio(solicitud.FondoCajaChica?.CustodioId ?? string.Empty)</td>
                                            <td class="r rep-money">@solicitud.MontoReclamado.ToString("N2")</td>
                                            <td>@RenderPdf(solicitud)</td>
                                            <td>
                                                <input class="rep-input" placeholder="N.º de transferencia, cheque o asiento"
                                                       value="@(referencias.TryGetValue(solicitud.Id, out var referenciaActual) ? referenciaActual : string.Empty)"
                                                       @onchange="e => referencias[solicitud.Id] = e.Value?.ToString() ?? string.Empty" />
                                            </td>
                                            <td class="act">
                                                <button type="button" class="rep-btn rep-btn-pri rep-btn-sm"
                                                        disabled="@(procesando is not null)" @onclick="() => PagarAsync(solicitud.Id)">
                                                    Registrar pago
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="rep-job quiet">
                <span class="rep-jic">@RenderIcono(IconoGuion)</span>
                <div>
                    <div class="rep-jt">Nada esperando aprobación de su parte</div>
                    <div class="rep-jd"><span>Las solicitudes llegan aquí sólo después de que el Gerente las aprueba.</span></div>
                </div>
                <div>
                    <div class="rep-jn cc-num">0</div>
                    <div class="rep-jnl">acciones</div>
                </div>
            </div>
        </text>;

    private RenderFragment RenderBandejaAuditor() =>
        @<div class="rep-job quiet">
            <span class="rep-jic">@RenderIcono(IconoOjo)</span>
            <div>
                <div class="rep-jt">Su rol es de consulta</div>
                <div class="rep-jd"><span>Ninguna reposición espera acción suya. Puede revisar cualquier solicitud y descargar su expediente.</span></div>
            </div>
            <div>
                <div class="rep-jn cc-num">0</div>
                <div class="rep-jnl">acciones</div>
            </div>
        </div>;

    // ── Historial por rol ────────────────────────────────────────────────────

    private RenderFragment RenderFiltros(bool mostrarConteo) =>
        @<div class="rep-filters">
            @if (mostrarConteo)
            {
                <span class="rep-mut" style="font-size:12px">@SolicitudesFiltradas.Count() en total</span>
            }
            <select class="rep-select rep-select-sm" value="@(diasSolicitudes?.ToString() ?? string.Empty)" @onchange="CambiarVentanaSolicitudes">
                <option value="30">Últimos 30 días</option>
                <option value="60">Últimos 60 días</option>
                <option value="90">Últimos 90 días</option>
                <option value="">Todo el historial</option>
            </select>
            @RenderBuscador("Buscar por referencia…", busquedaSolicitudes, valor => busquedaSolicitudes = valor)
        </div>;

    private RenderFragment RenderPdf(SolicitudReposicion solicitud) =>
        string.IsNullOrWhiteSpace(solicitud.RutaPdfConsolidado)
            ?@<span class="rep-mut">-</span>
            :@<a class="rep-btn rep-btn-ghost rep-btn-sm" href="/reposiciones/@solicitud.Id/pdf" target="_blank">Ver PDF</a>;

    private RenderFragment RenderTablaCustodio() =>
        @<div class="rep-card">
            <div class="rep-cb-head">
                <div class="rep-row">
                    <h2 class="rep-h2">Solicitudes del fondo</h2>
                    @RenderFiltros(mostrarConteo: false)
                </div>
            </div>
            <div class="rep-cb-body">
                @if (solicitudes is null)
                {
                    <p class="rep-empty"><em>Cargando...</em></p>
                }
                else if (solicitudes.Count == 0)
                {
                    <p class="rep-empty">Este fondo no tiene solicitudes todavía.</p>
                }
                else if (!SolicitudesFiltradas.Any())
                {
                    <p class="rep-empty">Ninguna solicitud coincide con la ventana o la búsqueda.</p>
                }
                else
                {
                    <div class="rep-tablewrap">
                        <table class="rep-table">
                            <thead>
                                <tr><th>Fecha</th><th>Solicitud</th><th class="r">Monto</th><th>Estado</th><th>Referencia</th><th class="act">Expediente</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var solicitud in SolicitudesFiltradas)
                                {
                                    <tr>
                                        <td class="cc-num">@FormatoFechaHora(solicitud.FechaSolicitud)</td>
                                        <td class="rep-code">@CodigoCorto(solicitud.Id)</td>
                                        <td class="r rep-money">@solicitud.MontoReclamado.ToString("N2")</td>
                                        <td><span class="rep-pill @ClaseEstado(solicitud.Estado)">@EtiquetaEstado(solicitud.Estado)</span></td>
                                        <td class="cc-num">@(solicitud.ReferenciaPago ?? "-")</td>
                                        <td class="act">@RenderPdf(solicitud)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>;

