@page "/reposiciones"
@rendermode InteractiveServer

@inject IFondoRepository Fondos
@inject IGastoRepository Gastos
@inject IReposicionRepository RepositorioReposiciones
@inject CrearSolicitudReposicionHandler Handler

<PageTitle>Reposiciones</PageTitle>

<h1>Solicitudes de reposicion</h1>

@if (errores.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in errores)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
@if (exito is not null)
{
    <div class="alert alert-success">@exito</div>
}

@if (fondos is null)
{
    <p><em>Cargando...</em></p>
}
else if (fondos.Count == 0)
{
    <div class="alert alert-warning">Primero cree <a href="/fondos">un fondo</a>.</div>
}
else
{
    <div class="mb-3" style="max-width: 480px;">
        <label class="form-label">Fondo</label>
        <select class="form-select" value="@fondoSeleccionado" @onchange="CambiarFondoAsync">
            @foreach (var fondo in fondos)
            {
                <option value="@fondo.Id">
                    Custodio @(string.IsNullOrWhiteSpace(fondo.CustodioId) ? "(sin asignar)" : fondo.CustodioId)
                    &mdash; disponible RD$ @fondo.BalanceActual.ToString("N2")
                </option>
            }
        </select>
    </div>

    @if (fondoActual is not null)
    {
        var umbral = fondoActual.MontoFijo * (PorcentajeAlerta(fondoActual) / 100m);
        var habilitada = fondoActual.BalanceActual <= umbral;

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h5">Gastos pendientes de reposicion</h2>

                @if (pendientes is null)
                {
                    <p><em>Cargando...</em></p>
                }
                else if (pendientes.Count == 0)
                {
                    <p class="text-muted mb-0">No hay gastos pendientes en este fondo.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>NCF</th>
                                <th>Proveedor</th>
                                <th class="text-center">Adjuntos</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gasto in pendientes)
                            {
                                <tr>
                                    <td>@gasto.FechaGasto.ToString("dd/MM/yyyy")</td>
                                    <td>@gasto.NCF</td>
                                    <td>@gasto.Proveedor</td>
                                    <td class="text-center">@gasto.Comprobantes.Count</td>
                                    <td class="text-end">@gasto.MontoTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="4" class="text-end">Total a reponer</td>
                                <td class="text-end">@pendientes.Sum(g => g.MontoTotal).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>

                    @if (!habilitada)
                    {
                        <div class="alert alert-warning">
                            Quedan RD$ @fondoActual.BalanceActual.ToString("N2") en el fondo.
                            La reposicion se habilita al bajar de RD$ @umbral.ToString("N2")
                            (@PorcentajeAlerta(fondoActual).ToString("N0")% del fondo fijo).
                        </div>
                    }

                    <button class="btn btn-primary" disabled="@(generando || !habilitada)" @onclick="GenerarAsync">
                        @(generando ? "Generando expediente..." : "Generar solicitud y expediente PDF")
                    </button>
                }
            </div>
        </div>
    }

    <h2 class="h5">Solicitudes del fondo</h2>
    @if (solicitudes is null)
    {
        <p><em>Cargando...</em></p>
    }
    else if (solicitudes.Count == 0)
    {
        <p class="text-muted">Este fondo no tiene solicitudes todavia.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Solicitud</th>
                    <th class="text-end">Monto reclamado</th>
                    <th>Estado</th>
                    <th>Expediente</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in solicitudes)
                {
                    <tr>
                        <td>@solicitud.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><code>@solicitud.Id.ToString()[..8]</code></td>
                        <td class="text-end">@solicitud.MontoReclamado.ToString("N2")</td>
                        <td>@solicitud.Estado</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(solicitud.RutaPdfConsolidado))
                            {
                                <span class="text-muted">-</span>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="/reposiciones/@solicitud.Id/pdf" target="_blank">
                                    Descargar PDF
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private const decimal PorcentajeAlertaPorDefecto = 30m;

    private IReadOnlyList<FondoCajaChica>? fondos;
    private IReadOnlyList<Gasto>? pendientes;
    private IReadOnlyList<SolicitudReposicion>? solicitudes;
    private FondoCajaChica? fondoActual;
    private Guid fondoSeleccionado;

    private readonly List<string> errores = new();
    private string? exito;
    private bool generando;

    protected override async Task OnInitializedAsync()
    {
        fondos = await Fondos.ListarAsync();

        if (fondos.Count > 0)
        {
            fondoSeleccionado = fondos[0].Id;
            await CargarFondoAsync(fondoSeleccionado);
        }
    }

    private static decimal PorcentajeAlerta(FondoCajaChica fondo) =>
        fondo.PorcentajeAlertaReposicion > 0 ? fondo.PorcentajeAlertaReposicion : PorcentajeAlertaPorDefecto;

    private async Task CambiarFondoAsync(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            errores.Clear();
            exito = null;
            fondoSeleccionado = id;
            await CargarFondoAsync(id);
        }
    }

    private async Task CargarFondoAsync(Guid fondoId)
    {
        pendientes = null;
        solicitudes = null;

        fondoActual = await Fondos.ObtenerPorIdAsync(fondoId);
        pendientes = await Gastos.ListarPendientesDeReposicionAsync(fondoId);
        solicitudes = await RepositorioReposiciones.ListarPorFondoAsync(fondoId);
    }

    private async Task GenerarAsync()
    {
        errores.Clear();
        exito = null;
        generando = true;

        try
        {
            var resultado = await Handler.EjecutarAsync(new CrearSolicitudReposicionCommand
            {
                FondoCajaChicaId = fondoSeleccionado
            });

            if (!resultado.Exitoso)
            {
                errores.AddRange(resultado.Errores);
                return;
            }

            exito = "Solicitud creada. El expediente PDF ya esta disponible para descargar.";
            await CargarFondoAsync(fondoSeleccionado);
        }
        catch (Exception ex)
        {
            errores.Add(ex.Message);
        }
        finally
        {
            generando = false;
        }
    }
}
