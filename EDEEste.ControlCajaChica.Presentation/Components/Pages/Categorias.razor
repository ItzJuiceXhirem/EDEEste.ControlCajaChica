@page "/categorias"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permisos.ConfigurarCategorias)]

<PageTitle>Categorías de gasto</PageTitle>

<h1>Categorías de gasto</h1>

@* Igual que Fondos: pantalla provisional de administración para poder tener con qué
   clasificar los gastos mientras no exista el caso de uso del Administrador. *@

@if (mensaje is not null)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row">
    <div class="col-lg-7">
        <h2 class="h5">Categorías registradas</h2>

        @if (categorias is null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (categorias.Count == 0)
        {
            <p class="text-muted">Todavía no hay categorías.</p>
        }
        else
        {
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Cuenta contable</th>
                        <th>Exige NCF</th>
                        <th>Activa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in categorias)
                    {
                        <tr>
                            <td>@categoria.Nombre</td>
                            <td>@categoria.CuentaContable</td>
                            <td>@(categoria.RequiereNCF ? "Si" : "No")</td>
                            <td>
                                @* El check no es solo indicador: marcarlo activa o
                                   desactiva la categoría en el momento. *@
                                <input type="checkbox" class="form-check-input"
                                       checked="@categoria.Activo"
                                       disabled="@(cambiandoId == categoria.Id)"
                                       title="@(categoria.Activo ? "Desactivar" : "Activar") esta categoría"
                                       aria-label="@(categoria.Activo ? "Desactivar" : "Activar") @categoria.Nombre"
                                       @onchange="e => CambiarActivoAsync(categoria, e.Value is true)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-lg-5">
        <h2 class="h5">Nueva categoría</h2>
        <EditForm Model="entrada" OnValidSubmit="CrearAsync" FormName="nueva-categoria">
            <div class="mb-2">
                <label class="form-label">Nombre</label>
                <InputText @bind-Value="entrada.Nombre" class="form-control" />
            </div>
            <div class="mb-2">
                <label class="form-label">Cuenta contable</label>
                <InputText @bind-Value="entrada.CuentaContable" class="form-control" />
            </div>
            <div class="form-check mb-2">
                <InputCheckbox @bind-Value="entrada.RequiereNCF" class="form-check-input" id="requiere-ncf" />
                <label class="form-check-label" for="requiere-ncf">Exige NCF</label>
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="entrada.Activo" class="form-check-input" id="activa" />
                <label class="form-check-label" for="activa">Activa</label>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@guardando">
                @(guardando ? "Guardando..." : "Crear categoría")
            </button>
        </EditForm>
    </div>
</div>
