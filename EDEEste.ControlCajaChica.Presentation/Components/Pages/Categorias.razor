@page "/categorias"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Permisos.ConfigurarCategorias)]

<PageTitle>Categorías de gasto</PageTitle>

<h1>Categorías de gasto</h1>

@if (errores.Count > 0)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in errores)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
@if (exito is not null)
{
    <div class="alert alert-success">@exito</div>
}

<div class="row">
    <div class="col-lg-7">
        <h2 class="h5">Categorías registradas</h2>

        @if (categorias is null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (categorias.Count == 0)
        {
            <p class="text-muted">Todavía no hay categorías.</p>
        }
        else
        {
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Cuenta contable</th>
                        <th>Exige NCF</th>
                        <th>Activa</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in categorias)
                    {
                        <tr>
                            <td>@categoria.Nombre</td>
                            <td>@categoria.CuentaContable</td>
                            <td>@(categoria.RequiereNCF ? "Si" : "No")</td>
                            <td>
                                @* El check no es solo indicador: marcarlo activa o
                                   desactiva la categoría en el momento. *@
                                <input type="checkbox" class="form-check-input"
                                       checked="@categoria.Activo"
                                       disabled="@(cambiandoId == categoria.Id)"
                                       title="@(categoria.Activo ? "Desactivar" : "Activar") esta categoría"
                                       aria-label="@(categoria.Activo ? "Desactivar" : "Activar") @categoria.Nombre"
                                       @onchange="e => CambiarActivoAsync(categoria, e.Value is true)" />
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => IniciarEdicion(categoria)">
                                    Editar
                                </button>
                            </td>
                        </tr>
                        @if (categoriaEnEdicion == categoria.Id && entradaEdicion is not null)
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="card card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-2">
                                                <label class="form-label">Nombre</label>
                                                <input class="form-control" maxlength="100" @bind="entradaEdicion.Nombre" />
                                            </div>
                                            <div class="col-md-6 mb-2">
                                                <label class="form-label">Cuenta contable</label>
                                                <input class="form-control" maxlength="50" @bind="entradaEdicion.CuentaContable" />
                                            </div>
                                        </div>
                                        <div class="form-check mb-2">
                                            <input type="checkbox" class="form-check-input" id="@($"editar-ncf-{categoria.Id}")"
                                                   @bind="entradaEdicion.RequiereNCF" />
                                            <label class="form-check-label" for="@($"editar-ncf-{categoria.Id}")">Exige NCF</label>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm btn-primary" disabled="@guardando"
                                                    @onclick="() => GuardarEdicionAsync(categoria)">
                                                @(guardando ? "Guardando..." : "Guardar cambios")
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelarEdicion">
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-lg-5">
        <h2 class="h5">Nueva categoría</h2>
        <EditForm Model="entrada" OnValidSubmit="CrearAsync" FormName="nueva-categoria">
            <div class="mb-2">
                <label class="form-label">Nombre</label>
                <InputText @bind-Value="entrada.Nombre" class="form-control" maxlength="100" />
            </div>
            <div class="mb-2">
                <label class="form-label">Cuenta contable</label>
                <InputText @bind-Value="entrada.CuentaContable" class="form-control" maxlength="50" />
            </div>
            <div class="form-check mb-2">
                <InputCheckbox @bind-Value="entrada.RequiereNCF" class="form-check-input" id="requiere-ncf" />
                <label class="form-check-label" for="requiere-ncf">Exige NCF</label>
            </div>
            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="entrada.Activo" class="form-check-input" id="activa" />
                <label class="form-check-label" for="activa">Activa</label>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@guardando">
                @(guardando ? "Guardando..." : "Crear categoría")
            </button>
        </EditForm>
    </div>
</div>
