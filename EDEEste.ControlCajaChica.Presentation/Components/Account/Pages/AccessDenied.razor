@page "/Account/AccessDenied"
@layout EDEEste.ControlCajaChica.Presentation.Components.Layout.AccesoLayout

<PageTitle>Acceso denegado</PageTitle>

<div class="cc-glow-wrap">
    <div class="cc-glow" style="--mc:#FF9AA3;--mc-bg:rgba(255,154,163,.30)">
        <svg class="cc-glow-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4.5 26 8v8.2c0 7-4.4 11.7-10 15-5.6-3.3-10-8-10-15V8Z" />
            <path d="M11.5 20.5l9-9" />
            <circle cx="16" cy="16" r="5.2" />
        </svg>
    </div>
</div>

<p class="cc-kicker cc-center">PERMISOS</p>
<h1 class="cc-center">Acceso denegado</h1>
<p class="cc-note cc-center" role="alert">No tiene acceso a este recurso del sistema.</p>

<div class="cc-next" style="--mc:#FF9AA3;--mc-bg2:rgba(255,154,163,.09)">
    <p class="cc-next-lb">Qué hacer</p>
    <p class="cc-next-txt">Si necesita acceso, comuníquese con el Administrador del sistema para que revise sus permisos.</p>
</div>

@* Esta pantalla la ve un usuario ya autenticado al que le falta un permiso
   puntual (a diferencia de AccesoDenegado.razor, que es para una cuenta a la
   que un Administrador le negó el acceso antes de iniciar sesión) -- así que
   "volver al inicio" es el panel de la app, no el login. *@
<a class="cc-cta" href="/">
    Volver al inicio
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11.5" /><path d="M11.4 5.8 15.6 10l-4.2 4.2" /></svg>
</a>
