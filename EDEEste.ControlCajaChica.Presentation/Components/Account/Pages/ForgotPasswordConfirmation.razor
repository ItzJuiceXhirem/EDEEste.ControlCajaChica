@page "/Account/ForgotPasswordConfirmation"
@attribute [ExcludeFromInteractiveRouting]
@layout EDEEste.ControlCajaChica.Presentation.Components.Layout.AccesoLayout
@rendermode InteractiveServer

<PageTitle>Solicitud enviada</PageTitle>

@* El ícono va antes del rastreador (y éste antes del texto), como en el diseño
   aprobado. El ícono cambia con el estado y el rastreador no, así que son dos
   condicionales sobre lo mismo en vez de repetir el rastreador tres veces. *@
@if (ignorada)
{
    <div class="cc-glow-wrap">
        <div class="cc-glow" style="--mc:#FF9AA3;--mc-bg:rgba(255,154,163,.30)">
            <svg class="cc-glow-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="11.5" />
                <path d="M12 12l8 8M20 12l-8 8" />
            </svg>
        </div>
    </div>
}
else if (aprobada)
{
    <div class="cc-glow-wrap">
        <div class="cc-glow" style="--mc:#85E0B3;--mc-bg:rgba(133,224,179,.32)">
            <svg class="cc-glow-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="11.5" />
                <path d="M11 16.3l3.4 3.4 7-7.4" />
            </svg>
        </div>
    </div>
}
else
{
    <div class="cc-glow-wrap">
        <div class="cc-glow" style="--mc:#7EE7FF;--mc-bg:rgba(126,231,255,.30)">
            <svg class="cc-glow-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 4.5h14M9 27.5h14" />
                <path d="M10.5 4.5v4.2c0 3 2.4 5 5.5 7.3 3.1-2.3 5.5-4.3 5.5-7.3V4.5M10.5 27.5v-4.2c0-3 2.4-5 5.5-7.3 3.1 2.3 5.5 4.3 5.5 7.3v4.2" />
            </svg>
        </div>
    </div>
}

@* Paso 2 de 3: la solicitud ya se envió, falta la aprobación del Administrador. *@
<div class="cc-steps-b" aria-hidden="true">
    <div class="cc-step-b cc-step-b-done"><span>1</span>Solicitar</div>
    <div class="cc-step-b-line cc-step-b-line-done"></div>
    <div class="cc-step-b cc-step-b-now"><span>2</span>Aprobación</div>
    <div class="cc-step-b-line"></div>
    <div class="cc-step-b"><span>3</span>Nueva clave</div>
</div>

<p class="cc-kicker cc-center">RECUPERAR ACCESO</p>

@if (ignorada)
{
    <h1 class="cc-center">Solicitud no procesada</h1>
    <p class="cc-note cc-center">Un Administrador revisó su solicitud y no la procesó.</p>
    <div class="cc-next" style="--mc:#FF9AA3;--mc-bg2:rgba(255,154,163,.09)">
        <p class="cc-next-lb">Qué hacer</p>
        <p class="cc-next-txt">
            Puede <a href="Account/ForgotPassword">intentarlo de nuevo</a> o comunicarse
            con el Administrador del sistema.
        </p>
    </div>
}
else if (aprobada)
{
    <h1 class="cc-center">Solicitud aprobada</h1>
    <p class="cc-note cc-center">
        Su solicitud fue aprobada. En breve recibirá, por Teams, el enlace del
        Administrador para definir su contraseña nueva.
    </p>
}
else
{
    <h1 class="cc-center">Solicitud enviada</h1>
    <p class="cc-note cc-center">
        Su solicitud de restablecimiento de contraseña fue enviada. Un Administrador
        debe aprobarla antes de que pueda definir una contraseña nueva.
    </p>
    <div class="cc-next" style="--mc:#7EE7FF;--mc-bg2:rgba(126,231,255,.09)">
        <p class="cc-next-lb">Mientras tanto</p>
        <p class="cc-next-txt">Cierre esta pantalla y espere el enlace que le mande el Administrador por Teams.</p>
    </div>
    <p class="cc-pulse"><em>Esperando aprobación...</em></p>
}

<a class="cc-cta" href="Account/Login">
    Volver al inicio de sesión
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11.5" /><path d="M11.4 5.8 15.6 10l-4.2 4.2" /></svg>
</a>
