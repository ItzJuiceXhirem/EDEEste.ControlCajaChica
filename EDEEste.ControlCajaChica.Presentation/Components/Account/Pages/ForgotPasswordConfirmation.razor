@page "/Account/ForgotPasswordConfirmation"
@rendermode InteractiveServer

<PageTitle>Solicitud enviada</PageTitle>

<h1>Solicitud enviada</h1>

@if (ignorada)
{
    <div class="alert alert-warning">
        <p class="mb-2">
            Un Administrador revisó su solicitud y no la procesó.
        </p>
        <p class="mb-0">
            Puede <a href="Account/ForgotPassword">intentarlo de nuevo</a> o
            comunicarse con el Administrador del sistema.
        </p>
    </div>
}
else if (aprobada)
{
    <div class="alert alert-success">
        <p class="mb-0">
            Su solicitud fue aprobada. En breve recibirá, por Teams, el enlace del
            Administrador para definir su contraseña nueva.
        </p>
    </div>
}
else
{
    <div class="alert alert-info">
        <p class="mb-2">
            Su solicitud de restablecimiento de contraseña fue enviada. Un
            Administrador debe aprobarla antes de que pueda definir una contraseña
            nueva.
        </p>
        <p class="mb-0">
            Cierre esta pantalla y espere el enlace que le mande el Administrador por
            Teams.
        </p>
    </div>
    <p><em>Esperando aprobación...</em></p>
}
