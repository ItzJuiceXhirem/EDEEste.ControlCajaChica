@page "/Account/Login"

<PageTitle>Iniciar sesión</PageTitle>

<h1>Iniciar sesión</h1>

<div class="row">
    <div class="col-lg-6">
        <section>
            <StatusMessage Message="@errorMessage" />

            @if (sinAdministrador)
            {
                <div class="alert alert-info">
                    Este sistema todavía no tiene un Administrador configurado.
                    <a href="/configuracion-inicial">Configurar el primer Administrador</a>.
                </div>
            }

            <EditForm EditContext="editContext" method="post" OnValidSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <h2 class="h5">Use su usuario de la empresa.</h2>
                <hr />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Usuario" id="Input.Usuario" class="form-control"
                               autocomplete="username" aria-required="true" placeholder="nombre.apellido" />
                    <label for="Input.Usuario" class="form-label">Usuario</label>
                    <ValidationMessage For="() => Input.Usuario" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control"
                               autocomplete="current-password" aria-required="true" placeholder="contraseña" />
                    <label for="Input.Password" class="form-label">Contraseña</label>
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        Recordarme
                    </label>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Iniciar sesión</button>
                </div>
                <hr />
                <div>
                    <p><a href="Account/ForgotPassword">Olvidé mi contraseña</a></p>
                    <p>
                        <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">
                            Solicitar acceso al sistema
                        </a>
                    </p>
                </div>
            </EditForm>
        </section>
    </div>
</div>
