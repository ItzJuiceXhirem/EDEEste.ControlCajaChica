@page "/Account/ResetPassword/{Id:guid}"
@layout EDEEste.ControlCajaChica.Presentation.Components.Layout.AccesoLayout

<PageTitle>Definir contraseña</PageTitle>

@if (invalida)
{
    <p class="cc-note cc-center"><em>Redirigiendo...</em></p>
}
else
{
    <div class="cc-glow-wrap">
        <div class="cc-glow cc-sm" style="--mc:#FFC300;--mc-bg:rgba(255,195,0,.32)">
            <svg class="cc-glow-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="7" y="14.5" width="18" height="12.5" rx="2.2" />
                <path d="M10.5 14.5v-3.8a5.5 5.5 0 0 1 9.7-3.5" />
                <path d="M12.5 20.5l2.6 2.6 4.4-4.6" />
            </svg>
        </div>
    </div>

    @* Paso 3 de 3: la solicitud ya fue aprobada, este enlace es el que el
       Administrador envió con el secreto de un solo uso (ver PasswordResetService). *@
    <div class="cc-steps-b" aria-hidden="true">
        <div class="cc-step-b cc-step-b-done"><span>1</span>Solicitar</div>
        <div class="cc-step-b-line cc-step-b-line-done"></div>
        <div class="cc-step-b cc-step-b-done"><span>2</span>Aprobación</div>
        <div class="cc-step-b-line cc-step-b-line-done"></div>
        <div class="cc-step-b cc-step-b-now"><span>3</span>Nueva clave</div>
    </div>

    <p class="cc-kicker cc-center">RECUPERAR ACCESO</p>
    <h1 class="cc-center">Definir contraseña</h1>
    <p class="cc-note cc-center">Cree una contraseña nueva para su cuenta. Mínimo 8 caracteres.</p>

    <StatusMessage Message="@Message" />
    <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="cc-fields">
            <div class="cc-f">
                <label class="cc-lb" for="Input.Password">Contraseña nueva</label>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control"
                           autocomplete="new-password" aria-required="true" placeholder="contraseña" />
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="cc-f">
                <label class="cc-lb" for="Input.ConfirmPassword">Confirmar contraseña</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control"
                           autocomplete="new-password" aria-required="true" placeholder="contraseña" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
        </div>

        <button type="submit" class="cc-cta">
            Guardar contraseña
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11.5" /><path d="M11.4 5.8 15.6 10l-4.2 4.2" /></svg>
        </button>
    </EditForm>
}
