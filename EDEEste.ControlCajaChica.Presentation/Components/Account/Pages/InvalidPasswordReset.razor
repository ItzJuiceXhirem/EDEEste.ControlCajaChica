@page "/Account/InvalidPasswordReset"
@attribute [ExcludeFromInteractiveRouting]
@layout EDEEste.ControlCajaChica.Presentation.Components.Layout.AccesoLayout

<PageTitle>Restablecimiento de contraseña fallido</PageTitle>

<div class="cc-glow-wrap">
    <div class="cc-glow" style="--mc:#FFC300;--mc-bg:rgba(255,195,0,.32)">
        <svg class="cc-glow-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 12l3.2-3.2a5 5 0 0 1 7.1 7.1L20 19" />
            <path d="M19 20l-3.2 3.2a5 5 0 0 1-7.1-7.1L12 13" />
        </svg>
    </div>
</div>

<p class="cc-kicker cc-center">RECUPERAR ACCESO</p>
<h1 class="cc-center">Enlace inválido o expirado</h1>
<p class="cc-note cc-center" role="alert">El enlace para restablecer la contraseña es inválido o ya expiró.</p>

<div class="cc-next" style="--mc:#FFC300;--mc-bg2:rgba(255,195,0,.09)">
    <p class="cc-next-lb">Siguiente paso</p>
    <p class="cc-next-txt">Solicite un nuevo enlace de restablecimiento; un Administrador deberá aprobarlo antes de que pueda usarlo.</p>
</div>

<a class="cc-cta" href="Account/ForgotPassword">
    Solicitar de nuevo
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11.5" /><path d="M11.4 5.8 15.6 10l-4.2 4.2" /></svg>
</a>

<div class="cc-sep"></div>
<div class="cc-lnk-row cc-center">
    <a href="Account/Login">Volver al inicio de sesión</a>
</div>
