@page "/Account/ForgotPassword"
@layout EDEEste.ControlCajaChica.Presentation.Components.Layout.AccesoLayout

<PageTitle>Olvidé mi contraseña</PageTitle>

<div class="cc-glow-wrap">
    <div class="cc-glow cc-sm" style="--mc:#FFC300;--mc-bg:rgba(255,195,0,.32)">
        <svg class="cc-glow-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="8" width="24" height="17" rx="2.4" />
            <path d="M4.8 9.2 16 18l11.2-8.8" />
        </svg>
    </div>
</div>

@* §5.4/nuevo: rastreador de los 3 pasos del ciclo de recuperación de acceso --
   esta pantalla es siempre el paso 1. *@
<div class="cc-steps-b" aria-hidden="true">
    <div class="cc-step-b cc-step-b-now"><span>1</span>Solicitar</div>
    <div class="cc-step-b-line"></div>
    <div class="cc-step-b"><span>2</span>Aprobación</div>
    <div class="cc-step-b-line"></div>
    <div class="cc-step-b"><span>3</span>Nueva clave</div>
</div>

<p class="cc-kicker cc-center">RECUPERAR ACCESO</p>
<h1 class="cc-center">Olvidé mi contraseña</h1>

@if (cuentaNoExiste)
{
    <div class="alert alert-warning">
        Esta cuenta no existe. <a href="Account/Register">Ir a registrarse</a>.
    </div>
}

<p class="cc-note cc-center">
    Escriba su usuario. Un Administrador debe aprobar la solicitud antes de que
    pueda definir una contraseña nueva.
</p>

<EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />

    <div class="cc-fields">
        <div class="cc-f">
            <label class="cc-lb" for="Input.Usuario">Usuario</label>
            <InputText @bind-Value="Input.Usuario" id="Input.Usuario" class="form-control"
                       autocomplete="username" aria-required="true" placeholder="nombre.apellido" />
            <ValidationMessage For="() => Input.Usuario" class="text-danger" />
        </div>
    </div>

    <button type="submit" class="cc-cta">
        Solicitar restablecimiento
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11.5" /><path d="M11.4 5.8 15.6 10l-4.2 4.2" /></svg>
    </button>
</EditForm>

<div class="cc-sep"></div>
<div class="cc-lnk-row cc-center">
    <a href="Account/Login">Volver al inicio de sesión</a>
</div>
