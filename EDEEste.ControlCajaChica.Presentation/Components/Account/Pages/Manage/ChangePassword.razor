@page "/Account/Manage/ChangePassword"

<PageTitle>Cambiar contraseña</PageTitle>

<h3>Cambiar contraseña</h3>
<StatusMessage Message="@message" />

@if (!tienePassword)
{
    <div class="alert alert-warning">
        Esta cuenta no tiene una contraseña propia en este sistema, así que no hay nada
        que cambiar aquí. Si necesita ayuda, comuníquese con el Administrador.
    </div>
}
else
{
    <div class="row">
        <div class="col-xl-6">
            <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.PasswordActual" id="Input.PasswordActual"
                               class="form-control" autocomplete="current-password" aria-required="true"
                               placeholder="contraseña actual" />
                    <label for="Input.PasswordActual" class="form-label">Contraseña actual</label>
                    <ValidationMessage For="() => Input.PasswordActual" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.PasswordNueva" id="Input.PasswordNueva"
                               class="form-control" autocomplete="new-password" aria-required="true"
                               placeholder="contraseña nueva" />
                    <label for="Input.PasswordNueva" class="form-label">Contraseña nueva</label>
                    <ValidationMessage For="() => Input.PasswordNueva" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText type="password" @bind-Value="Input.ConfirmarPassword" id="Input.ConfirmarPassword"
                               class="form-control" autocomplete="new-password" aria-required="true"
                               placeholder="contraseña nueva" />
                    <label for="Input.ConfirmarPassword" class="form-label">Confirmar contraseña</label>
                    <ValidationMessage For="() => Input.ConfirmarPassword" class="text-danger" />
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Actualizar contraseña</button>
            </EditForm>
        </div>
    </div>
}
