@page "/Account/Manage/ChangePassword"

<PageTitle>Cambiar contraseña</PageTitle>

<StatusMessage Message="@message" />

@if (!tienePassword)
{
    <div class="acc-alert acc-a-warn">
        Esta cuenta no tiene una contraseña propia en este sistema, así que no hay nada
        que cambiar aquí. Si necesita ayuda, comuníquese con el Administrador.
    </div>
}
else
{
    <div class="acc-alert acc-a-info">
        Al actualizar su contraseña, cualquier otra sesión abierta en otro dispositivo o navegador se cerrará.
    </div>

    <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="acc-summary" role="alert" />

        <div class="acc-mb acc-narrow">
            <label class="acc-cap" for="Input.PasswordActual">Contraseña actual</label>
            <InputText type="password" @bind-Value="Input.PasswordActual" id="Input.PasswordActual"
                       class="acc-field" autocomplete="current-password" aria-required="true" />
            <ValidationMessage For="() => Input.PasswordActual" class="acc-help-bad" />
        </div>
        <div class="acc-mb acc-narrow">
            <label class="acc-cap" for="Input.PasswordNueva">Contraseña nueva</label>
            <InputText type="password" @bind-Value="Input.PasswordNueva" id="Input.PasswordNueva"
                       class="acc-field" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.PasswordNueva" class="acc-help-bad" />
        </div>
        <div class="acc-mb acc-narrow">
            <label class="acc-cap" for="Input.ConfirmarPassword">Confirmar contraseña</label>
            <InputText type="password" @bind-Value="Input.ConfirmarPassword" id="Input.ConfirmarPassword"
                       class="acc-field" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.ConfirmarPassword" class="acc-help-bad" />
        </div>

        <button type="submit" class="acc-btn acc-btn-pri">Actualizar contraseña</button>
    </EditForm>
}
