@page "/Account/Manage"

<PageTitle>Perfil</PageTitle>

<h3>Perfil</h3>
<StatusMessage />

<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="profile" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <input type="text" value="@usuario" id="usuario" class="form-control" disabled />
                <label for="usuario" class="form-label">Usuario</label>
                <div class="form-text">
                    Es su usuario de la empresa y no se puede cambiar desde aquí.
                </div>
            </div>
            <div class="form-floating mb-3">
                <input type="text" value="@nombre" id="nombre" class="form-control" disabled />
                <label for="nombre" class="form-label">Nombre completo</label>
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Telefono" id="Input.Telefono" class="form-control"
                           placeholder="809-000-0000" />
                <label for="Input.Telefono" class="form-label">Teléfono</label>
                <ValidationMessage For="() => Input.Telefono" class="text-danger" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Guardar</button>
        </EditForm>
    </div>
</div>
