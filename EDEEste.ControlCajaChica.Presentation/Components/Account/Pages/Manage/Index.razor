@page "/Account/Manage"

<PageTitle>Perfil</PageTitle>

<StatusMessage Message="@(mensaje ?? MensajeDeEndpoint)" />

<EditForm Model="Input" OnValidSubmit="GuardarAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="acc-summary" role="alert" />

    <div class="acc-mb">
        <label class="acc-cap" for="usuario">Usuario</label>
        <input type="text" value="@usuario" id="usuario" class="acc-field acc-field-off" disabled />
        <p class="acc-help">Es su usuario de la empresa y no se puede cambiar desde aquí.</p>
    </div>
    <div class="acc-mb">
        <label class="acc-cap" for="nombre">Nombre completo</label>
        <input type="text" value="@nombre" id="nombre" class="acc-field acc-field-off" disabled />
    </div>
    <div class="acc-mb acc-narrow">
        <label class="acc-cap" for="Input.Extension">Extensión</label>
        <InputText @bind-Value="Input.Extension" id="Input.Extension" class="acc-field" maxlength="4"
                   inputmode="numeric" placeholder="0000" />
        <p class="acc-help">4 dígitos, sólo números — inserte su número de extensión telefónica.</p>
        <ValidationMessage For="() => Input.Extension" class="acc-help-bad" />
    </div>

    <button type="submit" class="acc-btn acc-btn-pri" disabled="@guardando">Guardar</button>
</EditForm>
