<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Persistence\Configurations\**" />
    <EmbeddedResource Remove="Persistence\Configurations\**" />
    <None Remove="Persistence\Configurations\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="10.0.11" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EDEEste.ControlCajaChica.Application\EDEEste.ControlCajaChica.Application.csproj" />
    <ProjectReference Include="..\EDEEste.ControlCajaChica.Domain\EDEEste.ControlCajaChica.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lato embebida (SIL OFL, ver Fonts/OFL.txt): es la misma tipografia que QuestPDF
         usaba por defecto, para que el expediente cambie de motor sin cambiar de cara.
         Se resuelve via ResolutorFuentesEmbebidas en vez de las fuentes del sistema
         porque UseWindowsFontsUnderWindows es "for developing and testing only" y
         lanza si la carpeta de fuentes no es accesible bajo la identidad del app pool
         de IIS. -->
    <EmbeddedResource Include="Fonts\Lato-Regular.ttf" />
    <EmbeddedResource Include="Fonts\Lato-Bold.ttf" />
    <EmbeddedResource Include="Fonts\Lato-Italic.ttf" />
    <EmbeddedResource Include="Fonts\Lato-BoldItalic.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Repositories\" />
    <Folder Include="Persistence\Migrations\" />
  </ItemGroup>

</Project>
